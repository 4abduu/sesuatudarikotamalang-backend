# Server Configuration
PORT=4000
NODE_ENV="development"
PUBLIC_BASE_URL="http://localhost:4000"
TRUST_PROXY="false"
# Kosongkan untuk lokal. Isi daftar origin frontend dipisahkan koma saat dibutuhkan.
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://192.168.1.8:3000,http://localhost:52674"
CORS_ALLOWED_ORIGINS=""

# Mobile release compatibility. Naikkan MOBILE_MIN_VERSION hanya setelah
# versi baru sudah tersedia untuk pengguna.
MOBILE_LATEST_VERSION="1.1.0"
MOBILE_MIN_VERSION="1.0.0"
MOBILE_UPDATE_URL=""

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sesuatu-darikota-malang"
UPLOAD_ORPHAN_GRACE_HOURS=24

# Database & Auth
DATABASE_URL="mysql://root:@localhost:3306/sesuatu_darikota_malang"
JWT_SECRET="ganti-dengan-string-rahasia-panjang-dan-acak"
# Opsional; bila kosong, kunci OTP diturunkan dari JWT_SECRET
OTP_PEPPER=""

# Seed akun operasional (wajib saat menjalankan seed yang sudah ada)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_BUYER_EMAIL=""

# Seed akun demo penilaian (opsional; kosong berarti dilewati)
SEED_DEMO_PASSWORD=""
SEED_DEMO_ADMIN_EMAIL=""
SEED_DEMO_CREATOR_EMAIL=""
SEED_DEMO_BUYER_EMAIL=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email OTP (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sesuatu DariKota Malang <onboarding@resend.dev>"

# Midtrans Payment Gateway
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_IS_SANITIZED="true"
MIDTRANS_IS_3DS="true"

# AI LLM Gemini — dapatkan API Key dari https://aistudio.google.com/
# Model yang digunakan pada konfigurasi lokal saat ini.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# Operasional dan moderasi
LOG_LEVEL="info"
COMPRESSION_ENABLED="true"
OPENAI_API_KEY=""
MODERATION_ENABLED="true"
# closed = gagal/timeout moderasi menolak upload (disarankan untuk produksi)
MODERATION_FAIL_MODE="closed"
