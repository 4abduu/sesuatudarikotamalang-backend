# Server Configuration
PORT=4000
NODE_ENV="development"
PUBLIC_BASE_URL="http://localhost:4000"
# false untuk lokal; gunakan 1 bila di belakang satu reverse proxy
TRUST_PROXY="false"
API_RATE_LIMIT_MAX="600"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sesuatu-darikota-malang"

# Database & Auth
DATABASE_URL="mysql://root:@localhost:3306/sesuatu_darikota_malang"
JWT_SECRET="ganti-dengan-string-rahasia-panjang-dan-acak"
# Opsional; bila kosong, kunci OTP diturunkan dari JWT_SECRET
OTP_PEPPER=""

# Seed akun operasional (wajib saat menjalankan seed yang sudah ada)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_BUYER_EMAIL=""

# Seed akun demo penilaian (opsional; kosong berarti dilewati)
SEED_DEMO_PASSWORD=""
SEED_DEMO_ADMIN_EMAIL=""
SEED_DEMO_CREATOR_EMAIL=""
SEED_DEMO_BUYER_EMAIL=""

# Google OAuth
GOOGLE_CLIENT_ID=""

# Email OTP (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sesuatu DariKota Malang <onboarding@resend.dev>"

# Midtrans Payment Gateway
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_IS_SANITIZED="true"
MIDTRANS_IS_3DS="true"

# AI LLM Gemini — dapatkan API Key dari https://aistudio.google.com/
# Model yang direkomendasikan: gemini-2.0-flash (lihat docs.generativeai.google untuk daftar lengkap)
GEMINI_API_KEY=""
GEMINI_MODEL=""